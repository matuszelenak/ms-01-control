[Unit]
Description=Fan, drive wear and CPU profile control for MinisForum MS-01
After=multi-user.target

[Service]
Type=exec
ExecStart=/usr/bin/ms01ctl
Restart=on-failure
RestartSec=5
# Hand fans back to hardware auto control if the service is stopped.
TimeoutStopSec=10

# Hardening (/sys stays writable under ProtectSystem=strict; the config
# directory and the wear history database need explicit exceptions)
ProtectSystem=strict
StateDirectory=ms01ctl
StateDirectoryMode=0750
ReadWritePaths=/etc/ms01ctl
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
